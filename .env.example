HEVY_BASE_URL=https://api.hevyapp.com
HEVY_API_KEY=shelobs_hevy_web
HEVY_BEARER_TOKEN=put_your_bearer_token_here  # copy from browser DevTools Network request Authorization header
HEVY_USERNAME=your_username_here
# Optional: override detected workouts-list endpoint (path or full URL)
# HEVY_WORKOUTS_ENDPOINT=/users/youruser/workouts
# Optional: include bar weight when sets were recorded "sin contar la barra"
# HEVY_INCLUDE_BAR_WEIGHT=1
# HEVY_BAR_WEIGHT_KG=20
